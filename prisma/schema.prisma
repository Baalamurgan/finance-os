// Family Finance OS — schema
// Models the joint-family monthly roll-up (v1 core, no settlement yet).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A household = a family (or, later, a "personal" household of one).
model Household {
  id         Int        @id @default(autoincrement())
  name       String
  type       String     @default("family") // family | personal
  treasurerMemberId Int? // hub member that everyone settles with (defaults to head)
  piggyHolderMemberId Int? // who physically holds the Piggy/pool in the in-hand view (defaults to head)
  windDownDay Int? // day of month the head aims to close/wind down; drives the reminder
  billRemindersOn Boolean @default(true) // master switch for the 3-day-before bill-due popups
  // A single shared family scratch note (behind the app lock). Any member can edit it — a
  // common place for important household details everyone should see.
  notes            String?
  notesUpdatedAt   DateTime?
  notesUpdatedById Int?
  // App-lock: one shared PIN for the whole household (set/reset by the head).
  // Everyone enters it after Google login. null = lock disabled.
  pinHash           String? // PBKDF2 hash of the 4-digit PIN
  pinSalt           String? // per-household salt (hex)
  pinFailedAttempts Int      @default(0) // consecutive wrong PINs (brute-force ladder)
  pinLockedUntil    DateTime? // temporary lockout after too many wrong PINs
  members      Member[]
  periods      Period[]
  categories   Category[]
  piggyEntries PiggyEntry[]
  settlements  SettlementRecord[]
  loans        Loan[]
  spendKeywords SpendKeyword[]
  spendShortcuts SpendShortcut[]
  miscCategories MiscCategory[]
  createdAt    DateTime     @default(now())
}

// Head-editable sub-category tags for family "Personal/Misc" spends (reporting-only — never touches
// settlement or budgets). Empty for a household = the built-in MISC_SUBCATEGORIES defaults are used;
// the first add/remove materialises the defaults into rows so the head edits a full list.
model MiscCategory {
  id          Int       @id @default(autoincrement())
  household   Household  @relation(fields: [householdId], references: [id])
  householdId Int
  name        String
  icon        String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([householdId, name])
  @@index([householdId, sortOrder])
}

// A loan or chit fund tracked with an outstanding balance / installment progress.
model Loan {
  id                Int      @id @default(autoincrement())
  household         Household @relation(fields: [householdId], references: [id])
  householdId       Int
  name              String // "BOB loan", "JL1", "Harish Chit"
  kind              String   @default("loan") // loan | chit
  outstanding       Float    @default(0) // loans: remaining principal
  monthlyAmount     Float    @default(0) // EMI / chit installment
  memberId          Int? // responsible member (for settlement tagging)
  totalInstallments Int? // chit: number of installments
  paidInstallments  Int      @default(0) // chit: installments paid so far
  chitWonInstallment Int?    // chit: the installment number in which the pot was won (null = not yet)
  chitPotAmount     Float?   // chit: the pot amount received when won
  interestRate      Float?   // annual % (loans, display only)
  note              String?
  status            String   @default("active") // active | closed
  payments          LoanPayment[]
  createdAt         DateTime @default(now())
}

model LoanPayment {
  id            Int      @id @default(autoincrement())
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId        Int
  periodId      Int? // the month it was paid in (optional link)
  amount        Float // total paid
  principalPart Float    @default(0) // amount that reduced outstanding (prepayments = full amount)
  dividend      Float    @default(0) // chit: dividend received that month (reduces net cost)
  note          String?
  createdAt     DateTime @default(now())

  @@index([loanId])
}

// Activity log — every money-affecting change, with who did it. Head-only view.
// Scalars (no relations) so it never couples to the other models' back-relations.
model ActivityLog {
  id          Int      @id @default(autoincrement())
  householdId Int
  memberId    Int?
  memberName  String?
  action      String // created | updated | deleted
  entity      String // income | expense | spend | settlement | piggy | loan
  summary     String
  periodId    Int?
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}

// The recurring template = the single source of truth for what repeats every month.
// Setup CRUDs these; each new month is GENERATED from the active items (+ that
// month's carry), instead of cloning the previous month. Per-line (categories are
// shared across many lines). Scalars only (no relations) like ActivityLog.
model RecurringItem {
  id          Int      @id @default(autoincrement())
  householdId Int
  kind        String // income | expense
  name        String // income source / expense label
  amount      Float
  categoryId  Int? // expense → Category (section + sinking/budget behaviour)
  memberId    Int? // income owner / expense payer (tags the generated line → settlement)
  active      Boolean  @default(true) // paused (kept, not generated) vs deleted (gone)
  sortOrder   Int      @default(0)
  // Schedule (anchored by installmentStart*): the item is DUE when months-since-start is
  // a multiple of intervalMonths. intervalMonths=1 = every month. installmentsTotal caps
  // the number of occurrences (null = forever). Generated label = "name N/total" only for
  // fixed-term installments; periodic items (interval>1) just show the name.
  //   • every month  → start=null (interval ignored)
  //   • installment  → interval=1, start set, total=N   (e.g. an EMI, N times)
  //   • periodic     → interval=N (2/6/12…), start=first-due month, total=null (or N times)
  intervalMonths      Int      @default(1)
  installmentsTotal   Int?
  installmentStartYear  Int?
  installmentStartMonth Int?
  dueDay              Int?     // informational day-of-month the bill lands (display only)
  createdAt   DateTime @default(now())

  @@index([householdId])
}

// A person in the household. `code` matches the sheet tags (H, B, L, KA, VL).
model Member {
  id          Int            @id @default(autoincrement())
  household   Household      @relation(fields: [householdId], references: [id])
  householdId Int
  name        String
  code        String
  email       String?        @unique // whitelisted Google email -> this member
  isEarner    Boolean        @default(true)
  role        String         @default("member") // head | member
  // Personal-finance mode: a private per-member space with its OWN lock, fully
  // isolated from the family roll-up. Null PIN = personal not set up yet.
  personalPinHash          String?
  personalPinSalt          String?
  personalPinFailedAttempts Int      @default(0)
  personalPinLockedUntil   DateTime?
  personalWindDownDay      Int?
  // When the member's Setup templates were first built from their month's recurring lines (one-time
  // switch-over to PersonalTemplate). null = not yet → built on next load.
  personalTemplatesAt      DateTime?
  personalOnboarded        Boolean   @default(false)
  // Personal OS assistant (per-member, bring-your-own-key). The API key itself lives
  // encrypted in Integration (provider=anthropic|openai, kind=apikey) — never here.
  assistantName            String?   // editable wake/display name (default "Jarvis")
  aiProvider               String?   // "anthropic" | "openai"
  aiModel                  String?   // chosen model id for that provider
  incomes     IncomeEntry[]
  expenses    ExpenseEntry[]
  spends      Spend[]      @relation("SpendMember")
  spendsLogged Spend[]     @relation("SpendLoggedBy")
  webauthnCreds WebAuthnCredential[]
  personalCategories PersonalCategory[]
  personalPeriods    PersonalPeriod[]
  personalExpenses   PersonalExpense[]
  personalSpends     PersonalSpend[]
  personalIncomes    PersonalIncome[]
  personalLoans      PersonalLoan[]
  financeAccounts    FinanceAccount[]
  accountTxns        AccountTransaction[]
  netWorthItems      NetWorthItem[]
  personalCardBills  PersonalCardBill[]
  personalSavings    PersonalSavings[]
  personalPlanItems  PersonalPlanItem[]
  personalTemplates  PersonalTemplate[]
  personalPlanSteps  PersonalPlanStep[]
  integrations       Integration[]

  @@unique([householdId, code])
}

// A registered platform biometric (Face ID / Touch ID / Android) for one member
// on one device. Unlocking with biometric = a WebAuthn assertion against these.
model WebAuthnCredential {
  id           Int      @id @default(autoincrement())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  credentialId String   @unique // base64url credential id
  publicKey    Bytes // COSE public key
  counter      Int      @default(0)
  transports   String? // csv of authenticator transports
  deviceLabel  String? // best-effort label ("iPhone", "This device")
  purpose      String   @default("family") // family | personal — which lock this unlocks
  createdAt    DateTime @default(now())
}

// ── Personal OS integrations (per-member secret vault) ────────────────────────
// Holds third-party credentials that CANNOT be re-fetched and so must persist:
//   • Google OAuth — one row per member (provider="google"), scopes accumulate via
//     incremental consent; refreshToken is the long-lived grant. accessToken is a
//     short-lived cache we can always re-mint from the refresh token.
//   • AI providers (later) — provider="anthropic"|"openai", kind="apikey", apiKeyEnc.
// Every secret column is AES-256-GCM encrypted at rest (see src/lib/crypto.ts). The
// app is single-household, but rows are per-member so personal keys never cross members.
model Integration {
  id              Int      @id @default(autoincrement())
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId        Int
  provider        String // "google" | "anthropic" | "openai"
  kind            String   @default("oauth") // "oauth" | "apikey"
  // oauth (Google)
  refreshTokenEnc String? // encrypted long-lived refresh token
  accessTokenEnc  String? // encrypted short-lived access token (cache)
  accessExpiresAt DateTime? // when the cached access token expires
  scopes          String? // space-separated granted scopes (the union we may use)
  // apikey (AI providers)
  apiKeyEnc       String?
  meta            Json? // provider account email, chosen model, etc.
  status          String   @default("connected") // connected | revoked | error
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, provider])
  @@index([memberId])
}

// ── Personal finance (private per member; never referenced by family tables) ──

model PersonalCategory {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  name      String
  icon      String?  // emoji
  bucket    String   @default("want") // need | want | invest (50/30/20 rule)
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  expenses  PersonalExpense[]
  spends    PersonalSpend[]
  createdAt DateTime @default(now())

  @@unique([memberId, name])
}

// Ad-hoc income within a personal month (salary is PersonalPeriod.income; these
// are extras — gifts, a parent topping you up — that raise the spendable total).
model PersonalIncome {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  period    PersonalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId  Int
  source    String
  amount    Float
  // Which of the member's balance accounts this income landed in (bank / cash / debit / prepaid). When set,
  // a 1:1 mirror ledger line (ledgerTxn) raises that account's balance — so the money shows up in real life.
  // null = untracked. The month's spendable (getPersonalCash) counts the income either way; SetNull on
  // account delete just detaches the tag (the mirror line cascades away with the income, not the account).
  account   FinanceAccount? @relation("PersonalIncomeAccount", fields: [accountId], references: [id], onDelete: SetNull)
  accountId Int?
  ledgerTxn AccountTransaction? @relation("PersonalIncomeLedger")
  // Recurring income templates (set in Personal setup) clone into each new month on `date`'s day-of-month
  // — mirrors the recurring flag on PersonalExpense. `date` is the day it lands (so it can be shown/ordered).
  date      DateTime @default(now())
  recurring Boolean  @default(false)
  // The Setup template this month's line was copied from (PersonalTemplate.id; plain id, no FK). Editing the
  // line never touches the template, and vice versa. null = a one-off line.
  templateId Int?
  createdAt DateTime @default(now())

  @@index([memberId, periodId])
}

model PersonalPeriod {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  year      Int
  month     Int
  label     String
  status    String   @default("open") // open | closed
  income    Float    @default(0) // the month's salary (single editable number)
  // The balance account the base salary lands in → generates a "Salary received" plan step that credits
  // it on tick (a ledger line tagged __baseincome__:<periodId>). null = salary just counts in the budget.
  incomeAccount   FinanceAccount? @relation("PeriodIncomeAccount", fields: [incomeAccountId], references: [id], onDelete: SetNull)
  incomeAccountId Int?
  carryForward Float @default(0) // previous month's remaining, carried in
  // When this month's plan steps were first created from Setup's transfers/savings (PersonalPlanItem). After
  // that, Setup changes never add/remove/edit this month's steps (use "Apply to this month" instead).
  planSeededAt DateTime?
  closedAt  DateTime?
  expenses  PersonalExpense[]
  spends    PersonalSpend[]
  incomes   PersonalIncome[]
  cardBills PersonalCardBill[]
  savings   PersonalSavings[]
  planSteps PersonalPlanStep[]
  createdAt DateTime @default(now())

  @@unique([memberId, year, month])
}

// Fixed monthly line-items on the Sheet (rent, subscriptions…). Label + amount,
// no category. `recurring` lines copy into the next month.
model PersonalExpense {
  id         Int      @id @default(autoincrement())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   Int
  period     PersonalPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId   Int
  category   PersonalCategory? @relation(fields: [categoryId], references: [id])
  categoryId Int?
  label      String   @default("")
  amount     Float
  note       String?
  date       DateTime @default(now())
  recurring  Boolean  @default(false)
  // Plan-driven: a recurring bill starts pending — generated as a plan step, NOT counted in Can-spend —
  // until its step is ticked (done). Ad-hoc bills are false (count immediately). Only seedRecurring sets true.
  pending    Boolean  @default(false)
  // Fixed bill paid by a credit card → deferred from cash like a CC spend (settles at
  // the card's bill). null = paid from cash. Carries when the line clones next month.
  cardAccount   FinanceAccount? @relation("PersonalExpenseCard", fields: [cardAccountId], references: [id], onDelete: SetNull)
  cardAccountId Int?
  // Bank / cash account a (recurring) bill is paid from — a plain id (cards use cardAccountId above). The
  // Money-Plan step's "paid from"; ticking it debits this account.
  payAccountId  Int?
  templateId Int? // the Setup template this line was copied from (see PersonalIncome.templateId)
  holdingId  Int? // invest bill: the NetWorthItem its payment adds to (copied from Setup; this month's own)
  createdAt  DateTime @default(now())

  @@index([memberId, periodId])
}

// Daily spends tracked in the Expenses tab — categorised, drawn against the
// remaining balance (income − fixed expenses − spends).
model PersonalSpend {
  id         Int      @id @default(autoincrement())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   Int
  period     PersonalPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId   Int
  category   PersonalCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
  amount     Float
  note       String?
  // Recurring spend template (set in Personal setup): clones into each new month on `date`'s day-of-month,
  // carrying its category + card. A normal daily spend leaves this false.
  recurring  Boolean  @default(false)
  // Plan-driven: a recurring spend starts pending — generated as a plan step, NOT counted in Can-spend —
  // until its step is ticked (done). Ad-hoc spends are false (count immediately). Only seedRecurring sets true.
  pending    Boolean  @default(false)
  date       DateTime @default(now())
  // Paid by a credit card → the cash leaves when that card's bill is paid, but the spend
  // still counts against this month at spend time. null = cash/UPI.
  cardAccount   FinanceAccount? @relation("PersonalSpendCard", fields: [cardAccountId], references: [id], onDelete: SetNull)
  cardAccountId Int?
  // Bank / cash account a (recurring) spend is paid from — plain id (cards use cardAccountId above).
  payAccountId  Int?
  // Shared spend: `amount` is the FULL amount paid (so card dues stay correct); sharedOthers
  // is the portion OTHERS owe, so your NET spend = amount − sharedOthers. null = not shared.
  sharedOthers  Float?
  // Ledger mirror on a debit/prepaid card (see AccountTransaction.personalSpendId). Credit-card spends
  // stay tag-only for now (their dues run through getCardDues); balance cards post a real ledger line.
  ledgerTxn  AccountTransaction? @relation("PersonalSpendLedger")
  // Receivables created from a split/reimbursement of THIS spend (one per person owing, or one for a
  // full reimbursement). Lets the spend row show your real out-of-pocket as people pay / are dropped.
  splitLoans PersonalLoan[]  @relation("SpendSplits")
  templateId Int? // the Setup template this spend was copied from (see PersonalIncome.templateId)
  holdingId  Int? // invest spend: the NetWorthItem its payment adds to (copied from Setup; this month's own)
  createdAt  DateTime @default(now())

  @@index([memberId, periodId])
}

model PersonalLoan {
  id           Int      @id @default(autoincrement())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  direction    String // lent | borrowed
  counterparty String
  amount       Float
  outstanding  Float
  note         String?
  status       String   @default("open") // open | settled
  // Shared-spend receivable: created when a spend is split ("I paid X, my share Y"). The
  // full X was logged as the spend, so receiving the owed part (X−Y) posts back as income.
  // sharedPaid != null marks such a loan (manual lends leave these null).
  sharedPaid   Float?   // the full amount paid on the shared spend
  sharedShare  Float?   // the member's own share of it
  // The spend this receivable was split/reimbursed from (null for manual lends). SetNull so
  // deleting the spend leaves the receivable standing (you're still owed the money).
  spend        PersonalSpend? @relation("SpendSplits", fields: [spendId], references: [id], onDelete: SetNull)
  spendId      Int?
  // Repay-by reminder. dueDate null = no reminder (legacy/manual without a date). notifyDaysBefore =
  // how many days ahead the nudge starts (bell + top bar), until the loan is settled/deleted.
  dueDate      DateTime?
  notifyDaysBefore Int  @default(3)
  // Peer-card usage: a spend one member made on ANOTHER member's card. The two sides (borrower +
  // lender) share a linkGroup uuid so settling/deleting either settles both. cardAccountId ties it to
  // the owner's card → the dueDate is derived from that card's cycle and is IMMUTABLE. SetNull so the
  // debt survives the card being deleted.
  linkGroup    String?
  cardAccount   FinanceAccount? @relation("PeerCardLoan", fields: [cardAccountId], references: [id], onDelete: SetNull)
  cardAccountId Int?
  // The member who CREATED this linked pair (manual lend, peer-card spend, or split/reimbursement). The
  // one-time heads-up notifies the OTHER side — the member who didn't initiate it — whatever the
  // direction. Null on legacy rows (they fall back to the spend-payer heuristic).
  initiatedById Int?
  createdAt    DateTime @default(now())

  @@index([linkGroup])
}

// A net-worth holding: a manually-valued asset or liability (stocks, MF, FD, PF, gold,
// property, land, loans…). Net worth also auto-includes credit-card outstanding
// (AccountTransaction) and open lending/borrowing (PersonalLoan) — those aren't stored here.
model NetWorthItem {
  id          Int      @id @default(autoincrement())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
  category    String   // asset | liability
  type        String   // stock | mutual_fund | fd | epf | ppf | nps | gold | cash | bank | property | land | vehicle | insurance | *_loan | other_*
  name        String
  value       Float    // CURRENT ₹ value (liabilities stored as a positive number). A contribution raises it by
                       // the same amount until the member next sets it (a "value" history entry).
  quantity    Float?   // units held (stocks / MF / gold) — optional
  institution String?  // broker / bank / fund house — optional
  notes       String?
  startDate    DateTime? // when it started (FD booking date, first SIP…) — optional
  tenureMonths Int?      // FD / RD tenure — drives the maturity date
  interestRate Float?    // FD / RD annual % — drives the maturity value
  valueAsOf    DateTime? // when the current value was last set by hand (null = never → it equals invested)
  entries     NetWorthEntry[]
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([memberId])
}

// A holding's dated history: the money that went in/out and every value update. Invested = Σ opening +
// contribution − withdrawal. A contribution made by ticking a Money Plan step (planStepId) or paying a planned
// spend (spendId) is removed again when that's undone.
model NetWorthEntry {
  id         Int      @id @default(autoincrement())
  memberId   Int
  item       NetWorthItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int
  date       DateTime
  kind       String   // opening | contribution | withdrawal | value
  amount     Float    // ₹ (for "value": the value it was set to)
  note       String?
  planStepId Int?     // contribution from ticking this PersonalPlanStep
  spendId    Int?     // contribution from paying this planned PersonalSpend
  createdAt  DateTime @default(now())

  @@index([itemId])
  @@index([memberId])
}

// Month-end net worth for the trend line (upserted whenever the Net worth tab loads, and at month roll).
model NetWorthSnapshot {
  id          Int      @id @default(autoincrement())
  memberId    Int
  year        Int
  month       Int
  netWorth    Float
  assets      Float
  liabilities Float
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([memberId, year, month])
}

// ── Finance (Wallet) — foundation for cards, and later bank/loan/investment ──────
// A financial account the member owns. Base record; type-specific detail (e.g. credit
// limit + billing cycle) lives in a 1:1 detail table so new account types extend cleanly.
model FinanceAccount {
  id          Int      @id @default(autoincrement())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
  type        String   // credit_card | debit_card | prepaid_card  (future: bank | loan | investment)
  name        String   // "SBI SimplyClick"
  institution String?  // bank / issuer, e.g. "SBI"
  network     String?  // visa | mastercard | rupay | amex | diners
  last4       String?
  color       String   @default("#6366f1")
  active      Boolean  @default(true)
  // Spends on this card aren't the family's cash now — they're reimbursed at the next settlement (like a
  // credit card, or a benefit wallet such as Pluxee whose balance isn't family money). When true, spends
  // are EXCLUDED from In-Hand and shown under "On cards · settles next month". Credit cards behave this
  // way inherently regardless of this flag; it's mainly for debit/prepaid benefit cards.
  reimbursed  Boolean  @default(false)
  // The member's FAMILY account (e.g. SBI): the bank/cash/debit/prepaid account that physically holds their
  // family In-Hand. At most one per member. Family Cash/UPI spends post to it (lowering its balance), and
  // the In-Hand card shows its balance beside the holding figure so the two can be matched.
  familyPrimary Boolean @default(false)
  // The member's PERSONAL money account (e.g. Jupiter): the personal app's "In account now" is its real balance.
  // At most one per member (enforced in code). None set + exactly one bank/cash account → that one is used.
  personalPrimary Boolean @default(false)
  sortOrder   Int      @default(0)
  // Debit/prepaid only: the balance when tracking started. Current balance = openingBalance + top-ups
  // + refunds − spends − fees (see src/lib/finance/balance.ts). Null/0 for credit cards.
  openingBalance Float? @default(0)
  credit      CreditCardDetail?
  txns        AccountTransaction[]
  taggedSpends   PersonalSpend[]   @relation("PersonalSpendCard")
  taggedExpenses PersonalExpense[] @relation("PersonalExpenseCard")
  taggedIncome   PersonalIncome[]  @relation("PersonalIncomeAccount")
  incomePeriods  PersonalPeriod[]  @relation("PeriodIncomeAccount")
  familySpends   Spend[]           @relation("FamilySpendCard")
  peerLoans      PersonalLoan[]    @relation("PeerCardLoan")
  cardBills      PersonalCardBill[]
  planItemsFrom  PersonalPlanItem[] @relation("PlanItemFrom")
  planItemsTo    PersonalPlanItem[] @relation("PlanItemTo")
  createdAt   DateTime @default(now())

  @@index([memberId])
}

// One settled credit-card bill cycle: its existence flips that card's cycle from "unpaid"
// to "paid" and posts the real cash outflow into `paidPeriod`. cycleEnd = the cycle's
// statement date (derived from statementDay), so a cycle is identified without a Statement
// entity. Undo = delete the row. See src/lib/personal/cash.ts.
model PersonalCardBill {
  id            Int      @id @default(autoincrement())
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId      Int
  cardAccount   FinanceAccount @relation(fields: [cardAccountId], references: [id], onDelete: Cascade)
  cardAccountId Int
  cycleEnd      DateTime // the cycle's statement date — identifies which bill this settles
  paidPeriod    PersonalPeriod @relation(fields: [paidPeriodId], references: [id], onDelete: Cascade)
  paidPeriodId  Int      // the personal month whose cash this bill payment leaves
  amount        Float
  paidAt        DateTime @default(now())

  @@unique([cardAccountId, cycleEnd])
  @@index([memberId])
  @@index([paidPeriodId])
}

// A private personal savings pot (the personal-mode analogue of the family Piggy).
// A flat ledger: positive = money set aside into the pot; negative = money pulled
// back OUT into a month (which also posts a one-off PersonalIncome to that month, so
// it raises that month's spendable). Balance = Σ amount. periodId is the month the
// entry relates to (the target month for a withdrawal); nullable so a deposit can be
// month-agnostic and so a deleted month leaves the pot balance intact (SetNull).
model PersonalSavings {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  period    PersonalPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  periodId  Int?
  amount    Float    // + into the pot, − out of the pot (brought into a month)
  note      String?
  createdAt DateTime @default(now())

  @@index([memberId])
}

// A recurring "money move" the member makes every month — the maintainable template behind the
// personal Money Plan (the personal parallel of the family RecurringItem). Each open month these
// surface as plan steps; a step reads as "done this month" when a matching ledger entry exists that
// month (a transfer_out on the source for a transfer, a PersonalSavings deposit for a save), so
// there's no per-month done flag to keep in sync — same read-derived principle as the rest of the plan.
// Setup's recurring income / bill / spend templates — the member's monthly setup, kept APART from any month.
// Each new month (and a preview) copies the active ones into its own rows (linked by templateId); editing a
// template only affects months created after it, and editing a month's row never touches the template.
model PersonalTemplate {
  id            Int      @id @default(autoincrement())
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId      Int
  kind          String   // income | expense | spend
  label         String   // income source / bill label / spend note
  amount        Float
  dayOfMonth    Int      @default(1) // 1–28
  categoryId    Int?     // expense + spend
  cardAccountId Int?     // expense + spend paid on a card (credit/debit/prepaid)
  payAccountId  Int?     // expense + spend paid from a bank / cash account
  accountId     Int?     // income: the balance account it lands in
  holdingId     Int?     // an INVEST-category bill/spend: the NetWorthItem each payment adds to
  note          String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([memberId])
}

model PersonalPlanItem {
  id            Int      @id @default(autoincrement())
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId      Int
  kind          String   // transfer (A→B between own accounts) | save (→ savings pot)
  label         String
  amount        Float
  dayOfMonth    Int?     // 1–28: when in the month it's due (null = anytime)
  // transfer: fromAccount + toAccount set. save: fromAccount optional (the account it comes out of),
  // toAccount null (it goes to the savings pot). SetNull so deleting an account leaves the item.
  fromAccount   FinanceAccount? @relation("PlanItemFrom", fields: [fromAccountId], references: [id], onDelete: SetNull)
  fromAccountId Int?
  toAccount     FinanceAccount? @relation("PlanItemTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  toAccountId   Int?
  holdingId     Int?     // a save/transfer into an investment: the NetWorthItem each tick adds to
  note          String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([memberId])
}

// This month's materialised Money-Plan steps for a member — the executable choreography. Generated each
// month from the templates (recurring income rows + PersonalPlanItem transfers/saves) and from one-off
// additions. Unlike the derived recurring-moves view, a step carries an EXPLICIT done state: ticking it
// executes the real money movement (income → credits the account; transfer → two ledger legs; save → a
// savings deposit) and unticking reverses it. dayOfMonth is re-dateable per month; status "skipped" hides
// it for this month only (the template still generates it again next month).
model PersonalPlanStep {
  id          Int      @id @default(autoincrement())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
  period      PersonalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId    Int
  kind        String   // income | transfer | save
  label       String
  amount      Float
  dayOfMonth  Int?     // 1–28: when it's due this month (re-dateable); null = anytime
  fromAccountId Int?   // transfer source / save source (raw id; a deleted account is handled in code)
  toAccountId   Int?   // income target / transfer destination
  // How the money moves: upi | cash | card | other (null = unspecified). Narrows which accounts the
  // sender/receiver pickers offer (UPI → bank accounts, cash → cash, card → cards).
  method      String?
  // Manual order within the month (move up/down / insert between). Null = fall back to the derived
  // day order; a move renumbers every step of the month so the set stays consistent.
  position    Float?
  // A month-only edit of a template-derived income/bill/spend step rewrites the underlying row for this
  // month; this keeps the ORIGINAL template values ({label|source, amount, cardAccountId|accountId}) so
  // next month still clones the Setup template, not this month's edit.
  snapshot    Json?
  holdingId   Int?     // ticking it adds a contribution to this NetWorthItem (investment bills / saves)
  note        String?
  // Provenance so monthly generation is idempotent. templateKind "income" → templateId = PersonalIncome.id;
  // "planitem" → templateId = PersonalPlanItem.id. Both null = a one-off step added this month.
  templateKind String?
  templateId   Int?
  // Execution. pending → tick executes (done); untick reverses. skipped = intentionally not this month.
  status  String   @default("pending") // pending | done | skipped
  doneAt  DateTime?
  // Ledger rows created on execute (deleted + cleared on undo). An income credit rides the AccountTransaction
  // keyed by its PersonalIncome mirror (personalIncomeId), so it needs no id stored here.
  transferOutId Int?
  transferInId  Int?
  savingsId     Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([periodId, templateKind, templateId])
  @@index([memberId, periodId])
}

// Credit-card specifics. Cycles are DERIVED from statementDay + dueOffsetDays (no
// Statement entity yet — that arrives in the statement-pipeline phase).
model CreditCardDetail {
  id            Int      @id @default(autoincrement())
  account       FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     Int      @unique
  creditLimit   Float?
  statementDay  Int?     // 1–28: day of month the statement generates
  dueOffsetDays Int?     // days after the statement date the payment is due
  reminderDays  Int?     // how many days before the due date the reminder fires (null → default)
  // Optional annual/joining fee the issuer charges once a year. When a bill's cycle falls in
  // annualFeeMonth, the card-bill total auto-includes annualFee on top of the summed swipes.
  annualFee      Float?  // ₹ charged once a year (null/0 = none)
  annualFeeMonth Int?    // 1–12: calendar month the fee hits the statement
}

// One ledger line on an account. The dashboard computes ONLY from these confirmed rows.
// Sign convention: spend/fee/interest/charge increase owed; payment/refund/cashback
// decrease owed; reward = points only (no rupee effect); adjustment = ±.
model AccountTransaction {
  id           Int      @id @default(autoincrement())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    Int
  date         DateTime
  merchant     String
  amount       Float    // rupees, positive
  type         String   @default("spend") // spend|payment|refund|cashback|reward|fee|interest|charge|adjustment
  rewardPoints Float?   // points earned/redeemed on this line
  category     String?  // free-text category from the statement / user
  bucket       String?  // need | want | invest (optional)
  confidence   Float?   // 0–1 from extraction; low → needsReview
  needsReview  Boolean  @default(false)
  source       String   @default("manual") // manual | import | family (mirrored from a family credit-card spend)
  // When this line was auto-created from a family credit-card Spend, it links back to it (1:1). Cascade
  // delete keeps the credit dashboard in sync when the family spend is removed. Null = a normal personal line.
  familySpend   Spend?  @relation("SpendMirrorTxn", fields: [familySpendId], references: [id], onDelete: Cascade)
  familySpendId Int?    @unique
  // When this line mirrors a PERSONAL spend logged on a debit/prepaid card (1:1). Cascade delete keeps the
  // card balance in sync when the personal spend is removed. Null = not a personal-spend mirror.
  personalSpend   PersonalSpend? @relation("PersonalSpendLedger", fields: [personalSpendId], references: [id], onDelete: Cascade)
  personalSpendId Int?           @unique
  // When this line mirrors a PERSONAL income deposited into a balance account (1:1). Cascade delete keeps
  // the account balance in sync when the income is removed. Null = not an income mirror.
  personalIncome   PersonalIncome? @relation("PersonalIncomeLedger", fields: [personalIncomeId], references: [id], onDelete: Cascade)
  personalIncomeId Int?            @unique
  // When this line mirrors a FUND/periodic BILL paid on a credit card (1:1). The bill is covered by its
  // sinking fund (settlement already nets it), but the cash physically rode the owner's card — so this
  // line puts it on that card's statement WITHOUT creating a reimbursable family spend (no double-pay).
  // Cascade delete reverses it when the bill payment is undone. Null = not a bill-payment mirror.
  billPayment   BillPayment? @relation("BillPaymentMirror", fields: [billPaymentId], references: [id], onDelete: Cascade)
  billPaymentId Int?         @unique
  createdAt    DateTime @default(now())

  @@index([memberId, date])
  @@index([accountId, date])
}

// A month (e.g. MAR 2026).
model Period {
  id           Int            @id @default(autoincrement())
  household    Household      @relation(fields: [householdId], references: [id])
  householdId  Int
  year         Int
  month        Int // 1-12
  label        String // "MAR 2026"
  status       String         @default("open") // open | closed
  treasurerMemberId Int? // per-month hub override; falls back to Household.treasurerMemberId
  carryForward Float          @default(0) // opening balance carried in from previous month
  movedToPiggy Float          @default(0) // amount sent to piggy at wind-down
  closedAt     DateTime?
  // When the wound-down month's general-Piggy leftover was physically handed from the category
  // owners to the Piggy holder. null after wind-down = still pending (shows as a tickable hand-over
  // step in the NEXT month's Money Plan; the pending lump sits in the owners' In-Hand meanwhile).
  piggyHandedOverAt DateTime?
  incomes      IncomeEntry[]
  expenses     ExpenseEntry[]
  budgets      Budget[]
  piggyEntries PiggyEntry[]
  spends       Spend[]
  settlements  SettlementRecord[]
  advances     Advance[]
  stepDayOverrides StepDayOverride[]
  stepOrderOverrides StepOrderOverride[]
  manualPlanSteps  ManualPlanStep[]
  hiddenPlanSteps  HiddenPlanStep[]
  poolHandovers    PoolHandover[]

  @@unique([householdId, year, month])
}

// Prior-month cash a member physically HOLDS that has become THIS month's pool income and must be
// handed to the treasurer: their own budget leftover routed to income at wind-down (kind "leftover")
// and/or the general Piggy taken as income (kind "piggy", held by the Piggy holder). Rendered as one
// combined "holder → treasurer" hand-over step per holder in the Money Plan; tickable via handedOverAt.
// A holder who IS the treasurer is never recorded (the cash is already at the hub).
model PoolHandover {
  id           Int       @id @default(autoincrement())
  period       Period    @relation(fields: [periodId], references: [id])
  periodId     Int // the month the income LANDS in (e.g. September)
  householdId  Int
  fromMemberId Int // the holder who must hand the cash to the treasurer
  kind         String // "leftover" | "piggy"
  amount       Float
  detail       String? // e.g. "LPG Gas, Petrol" (leftover categories); null for piggy
  handedOverAt DateTime? // set when ticked handed over; null = still pending
  createdAt    DateTime  @default(now())
  @@unique([periodId, fromMemberId, kind])
}

// A funding ADVANCE: someone (a member, or later a budget category) fronts cash to a member who'd
// otherwise be short for a step, scheduled just before it. Chosen by the user from a dropdown of
// sources that actually hold spare cash on that day. A member advance is a plain loan between people;
// a budget advance (Phase 2) is a temporary loan the budget gets repaid by wind-down.
model Advance {
  id             Int       @id @default(autoincrement())
  period         Period    @relation(fields: [periodId], references: [id])
  periodId       Int
  fromMemberId   Int? // who fronts it (a member); null when the source is a budget
  fromCategoryId Int? // Phase 2: a budget category source
  toMemberId     Int // the short member who receives it
  amount         Float
  day            Int? // scheduled day-of-month (before the step it funds); null = as needed
  note           String?
  settled        Boolean   @default(false) // the FRONT leg (funder → borrower) has been handed over
  settledAt      DateTime?
  // The PAYBACK leg: borrower → funder, once the borrower's income has landed to cover it. paybackDay
  // null = auto (computed live from income arrivals); a value = a manual override the plan respects.
  paybackDay       Int?
  paybackSettled   Boolean   @default(false)
  paybackSettledAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([periodId])
}

// Savings ledger. kind="piggy" = general Piggy (variable-category remainders);
// kind="sinking" = a sinking fund's own hold (WiFi/Mobile). categoryId gives the breakdown.
model PiggyEntry {
  id          Int       @id @default(autoincrement())
  household   Household  @relation(fields: [householdId], references: [id])
  householdId Int
  period      Period?    @relation(fields: [periodId], references: [id])
  periodId    Int?
  category    Category?  @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  kind        String     @default("piggy") // piggy | sinking
  amount      Float // positive = deposit, negative = withdrawal/payment
  note        String?
  createdAt   DateTime   @default(now())

  @@index([periodId])
}

// A due-month periodic bill (bill-with-a-fund) that's been paid, and how it was funded.
// One per (category, period); survives draft rebuilds so a paid bill stays paid. Scalar ids
// (no relations) keep it decoupled from the other models.
model BillPayment {
  id          Int      @id @default(autoincrement())
  householdId Int
  categoryId  Int
  periodId    Int
  memberId    Int? // the payer
  fromFund    Float    @default(0) // drawn from the bill's own ACCRUED sinking fund
  fromSetAside Float   @default(0) // covered by THIS month's own set-aside (cancels its wind-down accrual; no ledger draw)
  fromPiggy   Float    @default(0) // drawn from the general Piggy
  outOfPocket Float    @default(0) // paid out-of-pocket (also logged as a Misc Spend on the payer)
  spendPeriodId Int?   // where the money actually moved: = periodId normally; the OPEN month for a carried (late) payment of a prior closed month's bill
  // Paid physically on a credit card (a FinanceAccount owned by the payer) instead of cash/UPI. The bill
  // is still covered by its fund (settlement already nets it), but the cash rode this card — so a mirror
  // AccountTransaction (mirrorTxn) is put on that card's statement. Null = cash/UPI, no card charge.
  cardAccountId Int?
  mirrorTxn     AccountTransaction? @relation("BillPaymentMirror")
  paidAt      DateTime @default(now())

  @@unique([categoryId, periodId])
  @@index([periodId])
}

// Expense category (Veg, Loan, Utilities...) with a necessary/other default.
model Category {
  id          Int            @id @default(autoincrement())
  household   Household      @relation(fields: [householdId], references: [id])
  householdId Int
  name        String
  kind        String         @default("expense") // expense | income
  section     String         @default("Monthly") // Loans | Chits | Monthly | Misc
  necessary    Boolean        @default(true) // default; overridable per expense
  tracked      Boolean        @default(false) // variable category logged in the Expenses tab
  monthlyBudget Float?        // recurring default budget, used to seed new months (template)
  sinking      Boolean        @default(false) // true = accrues to its own hold until the bill is due
  cycleMonths  Int?           // payment cycle for sinking funds (WiFi=3, Mobile=12...)
  onHold       Boolean        @default(false) // paused: skipped when seeding new months & wind-down
  remind       Boolean        @default(true) // per-bill: show the due popup (until paid)
  reminderDays Int?          // per-bill: how many days before the due date to start reminding (null → default)
  fixed        Boolean        @default(false) // fixed monthly bill (e.g. subscription): a recurring Sheet expense tagged to the payer, not a budget
  // Allowance: a fixed monthly amount the family GIVES a member to spend at their discretion
  // (e.g. Harish/Lakshmi's personal money). Still a Sheet expense (leaves the pool), but it is
  // NOT a bill the member owes — it never shows a due date / overdue, and the Money Plan renders
  // it as a "Send ₹X to <member>" disbursement from the treasurer, not a bill or settlement blob.
  isAllowance  Boolean        @default(false)
  // "Full bill on due month" (the alternative to a sinking fund for a periodic bill):
  // the whole billAmount lands as an expense ONLY in its due month(s) — no monthly share,
  // no fund. billEveryMonths != null marks the category as this mode.
  billEveryMonths Int?        // 2 | 3 | 6 | 12 — how often the full bill recurs (null = not this mode)
  billMonth       Int?        // 1–12: the month the bill is due
  billDay         Int?        // optional day-of-month (informational)
  billAmount      Float?      // the full bill amount charged on the due month
  // "Bill with a fund" (goal-based): fundingStyle set = this category is a periodic bill
  // funded by its sinking bucket. auto = set aside (billAmount − fund) × saveEveryMonths ÷
  // months-left on each save-cadence month (self-correcting); fixed = set aside monthlyBudget;
  // none = pay it whole on the due month. The due month shows the full bill + a fund credit
  // (net = out-of-pocket). See src/lib/schedule.ts.
  fundingStyle    String?     // auto | fixed | none  (null = not a bill-with-a-fund)
  saveEveryMonths Int?        // save cadence for auto funding: 1 | 2 | 3 | 6 (null → 1/monthly). Divides billEveryMonths.
  needsReview     Boolean        @default(false) // migrated rolling sinking fund whose due month is a guess — prompt user to confirm
  // Planned-misc spend card: a budgeted (tracked, leftover→Piggy) category created for ONE month
  // from the Misc add flow — members log spends into it like veggies/fuel. By default it is one-off
  // (never cloned forward). If repeatYearly, the clone re-seeds it ONLY in billMonth each year.
  miscCard     Boolean        @default(false)
  repeatYearly Boolean        @default(false) // miscCard: re-seed every year in billMonth (else one-off)
  repeatMonthly Boolean       @default(false) // miscCard: re-seed EVERY month (a recurring variable budget)
  responsibleMemberId Int?     // budget: over-budget excess owner; bill-with-a-fund: the SAVER who sets aside the share & holds it (bears the cost)
  payerMemberId       Int?     // bill-with-a-fund: who physically PAYS the bill on its due month (null → same as the saver). Bill + fund credit tag to them → net ~0.
  onUnpaid    String         @default("carry") // bill-with-a-fund overdue behaviour: "carry" (unpaid share stays in the fund; nag in next month's In-Hand) | "skip" (subscription: release the held share back to general Piggy at wind-down)
  // Early-payment incentive + late penalty for a periodic bill (e.g. property / water tax). Paid within
  // the first 30 days of its due month (billMonth) → costs `earlyAmount` instead of billAmount; after the
  // cycle deadline (billMonth + billEveryMonths − 1, derived) → billAmount accrues `latePenaltyPct`%
  // SIMPLE interest per month late. Both null = a plain bill, no incentive/penalty. Window + deadline are
  // DERIVED from billMonth/billEveryMonths, so there are no extra date fields to keep in sync. See
  // src/lib/schedule.ts (billAmountForMonth). Editable in Setup like every other bill field.
  earlyAmount    Float?      // discounted price if paid in the incentive window (null = no early discount)
  latePenaltyPct Float?      // simple % per month on billAmount after the deadline (null = no penalty)
  expenses     ExpenseEntry[]
  budgets      Budget[]
  spends       Spend[]
  piggyEntries PiggyEntry[]
  spendKeywords SpendKeyword[]
  spendShortcuts SpendShortcut[]

  @@unique([householdId, name])
}

model IncomeEntry {
  id        Int      @id @default(autoincrement())
  period    Period   @relation(fields: [periodId], references: [id])
  periodId  Int
  source    String // "VL Salary", "G704 Rent"
  amount    Float
  owner     Member?  @relation(fields: [ownerId], references: [id])
  ownerId   Int?
  oneOff    Boolean  @default(false) // one-time income (e.g. a loan/piggy top-up) — NOT copied forward
  note      String?
  dueDay    Int?     // day-of-month this income arrives (from the template) — for the Money Plan ordering
  pinned    Boolean  @default(false) // value edited on the Sheet for THIS month — refresh-from-Setup leaves it alone
  receivedAt DateTime? // ticked "received" in the Money Plan → strikes the income row (display only)
  createdAt DateTime @default(now())

  @@index([periodId])
}

model ExpenseEntry {
  id         Int      @id @default(autoincrement())
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   Int
  label      String
  amount     Float
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  member     Member?  @relation(fields: [memberId], references: [id]) // attribution tag
  memberId   Int?
  necessary  Boolean  @default(true) // defaults from category, overridable
  oneOff     Boolean  @default(false) // wind-down carry (misc/over-budget) — NOT copied to future months
  note       String?
  paid       Boolean  @default(false) // a bill marked paid → drops out of "budget left in hand"
  paidAt     DateTime? // when it was marked paid — to show "paid <day>" when that differs from the due day
  dueDay     Int?     // day-of-month this bill is due (from the template) — powers overdue/near-due In-Hand highlighting
  pinned     Boolean  @default(false) // value edited on the Sheet for THIS month — refresh-from-Setup leaves it alone
  // Two-step pool-funded misc (note=__poolbill__) has two independently-tickable legs, like an advance's
  // front + payback: `paid`/`paidAt` above track leg 1 (treasurer → member disbursement); the pair below
  // track leg 2 (member → vendor payment). Unused (false/null) for every other kind of line.
  vendorPaid   Boolean  @default(false)
  vendorPaidAt DateTime?
  createdAt  DateTime @default(now())

  @@index([periodId])
}

// A head-set day override for a Money-plan step that has no row of its own to hold a date — a
// periodic/fund bill (its date otherwise comes from the category config) or the Piggy hand-over
// (otherwise derived from the wind-down date). Keyed by a stable stepKey so it survives a rebuild;
// day null is never stored (the override is deleted to fall back to the derived date).
model StepDayOverride {
  id       Int    @id @default(autoincrement())
  period   Period @relation(fields: [periodId], references: [id])
  periodId Int
  stepKey  String // e.g. "fund-<categoryId>", "piggyho-<priorPeriodId>-<ownerId>"
  day      Int
  @@unique([periodId, stepKey])
}

// Head-set MANUAL ordering of Money-Plan steps (move up/down). Keyed by the step's id; sortIndex overrides
// the derived (day/rank) order in the plan's final sort. A move renumbers every step for this period, so
// the set stays consistent; steps with no row here fall back to their derived position.
model StepOrderOverride {
  id        Int    @id @default(autoincrement())
  period    Period @relation(fields: [periodId], references: [id])
  periodId  Int
  stepKey   String // the PlanStep.id (e.g. "bill-123", "disb-3-1-20-52631", "xfer-2-1")
  sortIndex Float
  @@unique([periodId, stepKey])
}

// Head-added ad-hoc Money-plan step: a real member→member (or →/from hub) move inserted between two
// steps. Persisted so a plan refresh keeps it. `afterStepKey` = the plan-step id it sits right after
// (null = top); it moves the running balances like a transfer and is tickable.
model ManualPlanStep {
  id           Int      @id @default(autoincrement())
  period       Period   @relation(fields: [periodId], references: [id])
  periodId     Int
  fromMemberId Int // sender (a member; the hub = the treasurer's member id)
  toMemberId   Int // receiver
  amount       Float
  // When set, this is a FUNDING move earmarked for that ExpenseEntry bill (funder → payer): the plan
  // shrinks the hub's disbursement to the payer by this amount and places the move just above the bill.
  fundsExpenseId Int?
  // A REPAYABLE bridge = 3 steps sharing one bridgeGroup: funder→debtor (with fundsExpenseId, above the
  // bill), debtor→hub and hub→funder (the pay-back, when the debtor's income lands). Grouped so the whole
  // bridge is deleted as a unit (never half-removed, which would unbalance the pool). Null = normal step.
  bridgeGroup  String?
  afterStepKey String? // the plan-step id this was inserted AFTER (null = top of the list)
  day          Int? // fallback ordering / display if the anchor step is gone
  note         String?
  done         Boolean  @default(false)
  doneAt       DateTime? // when it was ticked done (Transactions tab sorts by it); null = pending / ticked pre-column
  createdAt    DateTime @default(now())

  @@index([periodId])
}

// Head-hidden Money-plan step: removes a derived step from the plan VIEW only (the underlying
// bill/income/Sheet is untouched). Persisted so a refresh keeps it hidden; deleted to un-hide.
model HiddenPlanStep {
  id       Int    @id @default(autoincrement())
  period   Period @relation(fields: [periodId], references: [id])
  periodId Int
  stepKey  String // the plan-step id to hide
  @@unique([periodId, stepKey])
}

// Actual logged spend within a tracked category (the daily WhatsApp-group entries).
// Separate from ExpenseEntry so the Sheet (allocations) never double-counts.
model Spend {
  id         Int      @id @default(autoincrement())
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  member     Member?  @relation("SpendMember", fields: [memberId], references: [id])
  memberId   Int?
  // Who actually LOGGED this spend (the authenticated member). The head can log for another member,
  // and a family-card spend attributes to the card owner — so the logger and `member` (whom it's
  // filed under) can differ. Null for spends created before this was tracked. SetNull on member delete.
  loggedBy   Member?  @relation("SpendLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)
  loggedById Int?
  // Paid with a family card (a FinanceAccount) instead of cash/UPI. Null = cash/UPI. When set, the spend
  // is attributed to the card's OWNER (memberId = account.memberId) — the card is the authority on who
  // paid. onDelete: SetNull so removing a card leaves past spends intact (they keep memberId).
  cardAccount   FinanceAccount? @relation("FamilySpendCard", fields: [cardAccountId], references: [id], onDelete: SetNull)
  cardAccountId Int?
  // Mirror ledger line on the card OWNER's personal credit dashboard, created when this spend is paid
  // with a CREDIT family card (so the owner's card outstanding reflects it). Debit/cash spends have none.
  // Cascade: deleting the spend removes the mirror; editing the spend keeps the mirror's amount in sync.
  mirrorTxn  AccountTransaction? @relation("SpendMirrorTxn")
  label      String
  amount     Float
  subCategory String? // reporting-only tag for Personal/Misc spends (Food, Travel…); null = uncategorized
  imagePath  String? // /uploads/<file> for petrol receipts etc.
  reviewIgnored Boolean @default(false) // "Review Misc" dismissed: a genuine misc spend, don't keep suggesting a move
  // Set on a REFUND line (a negative spend booked by the Refund modal): the original spend it corrects.
  // Refund lines are created/removed only through SpendRefund (never edited or deleted directly).
  refundOfId Int?
  spentOn    DateTime? // the day it was spent (IST midnight), picked in the Add-spend modal; null = the day it was logged (createdAt)
  createdAt  DateTime @default(now())

  @@index([periodId])
}

// A refund raised against ONE spend (head only, any month) — duplicate entry, wrong amount, shop refund or
// wrong category. Every piece it creates is linked here so Undo removes exactly those pieces:
//   refundSpendId — the negative spend in the open month (budget back to the category; also fixes the card)
//   incomeId      — the pool income line (budget back to the pool instead), this month or next month's preview
//   cardTxnId     — a standalone card/account correction line when there's no refund spend (pool route)
//   stepId        — the Money Plan move "spender → holder" when the money is sent now
//   moveSpendId   — wrong category: the +amount spend in the new category (refundSpendId is the −amount one)
model SpendRefund {
  id            Int      @id @default(autoincrement())
  householdId   Int
  spendId       Int      @unique // the original spend (one refund per spend for now)
  kind          String   // duplicate | amount | shop | category
  amount        Float    // money corrected (the moved amount for "category")
  budgetTo      String   // category | pool | none
  payWhen       String   // now | next | none
  periodId      Int      // the open month it was booked in
  refundSpendId Int?
  moveSpendId   Int?
  incomeId      Int?
  cardTxnId     Int?
  stepId        Int?
  createdById   Int?
  createdAt     DateTime @default(now())

  @@index([periodId])
}

// Learned item→category memory that reinforces the Add-Spend nudge. Seed knowledge
// lives in code (src/lib/spendCategorize.ts); this table only holds what the household
// TEACHES the app — each save to a tracked (non-misc) category upserts the item here
// (+1 hits). A high enough hit-count lets a learned word win over a seed. Never affects
// settlement or budgets; it's purely a suggestion source.
model SpendKeyword {
  id          Int      @id @default(autoincrement())
  household   Household @relation(fields: [householdId], references: [id])
  householdId Int
  keyword     String    // normalized (lowercase, punctuation-stripped) item label
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int
  hits        Int       @default(1)
  createdAt   DateTime  @default(now())

  @@unique([householdId, keyword])
  @@index([householdId])
}

// Head-curated "quick add" chip in the Add-Spend modal: one tap fills the item label
// AND selects the category, so frequent staples never land in Misc by mistake. Also
// feeds the on-save category suggestion (a shortcut is a high-confidence keyword).
model SpendShortcut {
  id          Int      @id @default(autoincrement())
  household   Household @relation(fields: [householdId], references: [id])
  householdId Int
  icon        String?   // emoji shown on the chip
  label       String    // the word: shown on the chip AND prefilled into "what was bought"
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

// A recorded settlement payment: one transfer (from → to) marked paid for a month.
// Member ids are plain scalars (names resolved from the loaded member list).
model SettlementRecord {
  id           Int       @id @default(autoincrement())
  household    Household  @relation(fields: [householdId], references: [id])
  householdId  Int
  period       Period     @relation(fields: [periodId], references: [id])
  periodId     Int
  fromMemberId Int // who pays
  toMemberId   Int // who receives (the treasurer/hub)
  amount       Float // amount of THIS payment (a pair's total paid = sum of its rows)
  note         String?
  settledById  Int? // session member who marked it
  settledAt    DateTime   @default(now())
  // Per-payment model: a settlement can be paid in several slices (one per Money-Plan piece), so
  // there can be MANY rows per (period, from, to). `key` is the ticked step's stable id — ticking is
  // an upsert on it, so a double-click updates the same row instead of double-recording a payment.
  key          String?

  @@unique([periodId, key])
  @@index([periodId, fromMemberId, toMemberId])
}

// Planned amount per category per month (planned-vs-actual).
model Budget {
  id         Int      @id @default(autoincrement())
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  planned    Float
  // Part of `planned` taken off for last month's overspend (wind-down groups). Kept so a re-run on a
  // hand-edited (pinned) budget can put the old cut back before taking the new one — never cut twice.
  carryCut   Float    @default(0)

  @@unique([periodId, categoryId])
}

// A one-off "skip this month's set-aside" for a bill-with-a-fund category. Its presence
// means: don't put this bill's monthly set-aside on that period's sheet and don't accrue
// it to the fund at wind-down. The remaining months auto-recompute higher. Source of truth
// (survives a preview rebuild). Removed = the set-aside is back to normal.
model SetAsideSkip {
  id          Int      @id @default(autoincrement())
  householdId Int
  categoryId  Int
  periodId    Int
  createdAt   DateTime @default(now())

  @@unique([categoryId, periodId])
  @@index([periodId])
}

// Wind-down "where the money goes" choices for ONE month (saved ahead on the Wind-down tab). Each row is a
// group of budgeted categories settled together: their leftovers and overspends net out; a net overspend
// is cut from next month's budgets (`cuts` = the edited split, [{categoryId, amount}], null = automatic),
// a net leftover goes to `destination` ("piggy" | "income"). A single category with a non-default choice
// is a group of one. No row = that category on its own, leftover → Piggy.
model WindDownChoice {
  id          Int      @id @default(autoincrement())
  householdId Int
  periodId    Int
  categoryIds Int[]
  destination String   @default("piggy")
  cuts        Json?
  updatedAt   DateTime @updatedAt

  @@index([periodId])
}
