// Family Finance OS — schema
// Models the joint-family monthly roll-up (v1 core, no settlement yet).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A household = a family (or, later, a "personal" household of one).
model Household {
  id         Int        @id @default(autoincrement())
  name       String
  type       String     @default("family") // family | personal
  treasurerMemberId Int? // hub member that everyone settles with (defaults to head)
  piggyHolderMemberId Int? // who physically holds the Piggy/pool in the in-hand view (defaults to head)
  windDownDay Int? // day of month the head aims to close/wind down; drives the reminder
  // App-lock: one shared PIN for the whole household (set/reset by the head).
  // Everyone enters it after Google login. null = lock disabled.
  pinHash           String? // PBKDF2 hash of the 4-digit PIN
  pinSalt           String? // per-household salt (hex)
  pinFailedAttempts Int      @default(0) // consecutive wrong PINs (brute-force ladder)
  pinLockedUntil    DateTime? // temporary lockout after too many wrong PINs
  members      Member[]
  periods      Period[]
  categories   Category[]
  piggyEntries PiggyEntry[]
  settlements  SettlementRecord[]
  loans        Loan[]
  createdAt    DateTime     @default(now())
}

// A loan or chit fund tracked with an outstanding balance / installment progress.
model Loan {
  id                Int      @id @default(autoincrement())
  household         Household @relation(fields: [householdId], references: [id])
  householdId       Int
  name              String // "BOB loan", "JL1", "Harish Chit"
  kind              String   @default("loan") // loan | chit
  outstanding       Float    @default(0) // loans: remaining principal
  monthlyAmount     Float    @default(0) // EMI / chit installment
  memberId          Int? // responsible member (for settlement tagging)
  totalInstallments Int? // chit: number of installments
  paidInstallments  Int      @default(0) // chit: installments paid so far
  chitWonInstallment Int?    // chit: the installment number in which the pot was won (null = not yet)
  chitPotAmount     Float?   // chit: the pot amount received when won
  interestRate      Float?   // annual % (loans, display only)
  note              String?
  status            String   @default("active") // active | closed
  payments          LoanPayment[]
  createdAt         DateTime @default(now())
}

model LoanPayment {
  id            Int      @id @default(autoincrement())
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId        Int
  periodId      Int? // the month it was paid in (optional link)
  amount        Float // total paid
  principalPart Float    @default(0) // amount that reduced outstanding (prepayments = full amount)
  dividend      Float    @default(0) // chit: dividend received that month (reduces net cost)
  note          String?
  createdAt     DateTime @default(now())
}

// Activity log — every money-affecting change, with who did it. Head-only view.
// Scalars (no relations) so it never couples to the other models' back-relations.
model ActivityLog {
  id          Int      @id @default(autoincrement())
  householdId Int
  memberId    Int?
  memberName  String?
  action      String // created | updated | deleted
  entity      String // income | expense | spend | settlement | piggy | loan
  summary     String
  periodId    Int?
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}

// The recurring template = the single source of truth for what repeats every month.
// Setup CRUDs these; each new month is GENERATED from the active items (+ that
// month's carry), instead of cloning the previous month. Per-line (categories are
// shared across many lines). Scalars only (no relations) like ActivityLog.
model RecurringItem {
  id          Int      @id @default(autoincrement())
  householdId Int
  kind        String // income | expense
  name        String // income source / expense label
  amount      Float
  categoryId  Int? // expense → Category (section + sinking/budget behaviour)
  memberId    Int? // income owner / expense payer (tags the generated line → settlement)
  active      Boolean  @default(true) // paused (kept, not generated) vs deleted (gone)
  sortOrder   Int      @default(0)
  // Schedule (anchored by installmentStart*): the item is DUE when months-since-start is
  // a multiple of intervalMonths. intervalMonths=1 = every month. installmentsTotal caps
  // the number of occurrences (null = forever). Generated label = "name N/total" only for
  // fixed-term installments; periodic items (interval>1) just show the name.
  //   • every month  → start=null (interval ignored)
  //   • installment  → interval=1, start set, total=N   (e.g. an EMI, N times)
  //   • periodic     → interval=N (2/6/12…), start=first-due month, total=null (or N times)
  intervalMonths      Int      @default(1)
  installmentsTotal   Int?
  installmentStartYear  Int?
  installmentStartMonth Int?
  dueDay              Int?     // informational day-of-month the bill lands (display only)
  createdAt   DateTime @default(now())

  @@index([householdId])
}

// A person in the household. `code` matches the sheet tags (H, B, L, KA, VL).
model Member {
  id          Int            @id @default(autoincrement())
  household   Household      @relation(fields: [householdId], references: [id])
  householdId Int
  name        String
  code        String
  email       String?        @unique // whitelisted Google email -> this member
  isEarner    Boolean        @default(true)
  role        String         @default("member") // head | member
  // Personal-finance mode: a private per-member space with its OWN lock, fully
  // isolated from the family roll-up. Null PIN = personal not set up yet.
  personalPinHash          String?
  personalPinSalt          String?
  personalPinFailedAttempts Int      @default(0)
  personalPinLockedUntil   DateTime?
  personalWindDownDay      Int?
  personalOnboarded        Boolean   @default(false)
  incomes     IncomeEntry[]
  expenses    ExpenseEntry[]
  spends      Spend[]
  webauthnCreds WebAuthnCredential[]
  personalCategories PersonalCategory[]
  personalPeriods    PersonalPeriod[]
  personalExpenses   PersonalExpense[]
  personalSpends     PersonalSpend[]
  personalIncomes    PersonalIncome[]
  personalLoans      PersonalLoan[]
  financeAccounts    FinanceAccount[]
  accountTxns        AccountTransaction[]
  netWorthItems      NetWorthItem[]

  @@unique([householdId, code])
}

// A registered platform biometric (Face ID / Touch ID / Android) for one member
// on one device. Unlocking with biometric = a WebAuthn assertion against these.
model WebAuthnCredential {
  id           Int      @id @default(autoincrement())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  credentialId String   @unique // base64url credential id
  publicKey    Bytes // COSE public key
  counter      Int      @default(0)
  transports   String? // csv of authenticator transports
  deviceLabel  String? // best-effort label ("iPhone", "This device")
  purpose      String   @default("family") // family | personal — which lock this unlocks
  createdAt    DateTime @default(now())
}

// ── Personal finance (private per member; never referenced by family tables) ──

model PersonalCategory {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  name      String
  icon      String?  // emoji
  bucket    String   @default("want") // need | want | invest (50/30/20 rule)
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  expenses  PersonalExpense[]
  spends    PersonalSpend[]
  createdAt DateTime @default(now())

  @@unique([memberId, name])
}

// Ad-hoc income within a personal month (salary is PersonalPeriod.income; these
// are extras — gifts, a parent topping you up — that raise the spendable total).
model PersonalIncome {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  period    PersonalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId  Int
  source    String
  amount    Float
  createdAt DateTime @default(now())
}

model PersonalPeriod {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  year      Int
  month     Int
  label     String
  status    String   @default("open") // open | closed
  income    Float    @default(0) // the month's salary (single editable number)
  carryForward Float @default(0) // previous month's remaining, carried in
  closedAt  DateTime?
  expenses  PersonalExpense[]
  spends    PersonalSpend[]
  incomes   PersonalIncome[]
  createdAt DateTime @default(now())

  @@unique([memberId, year, month])
}

// Fixed monthly line-items on the Sheet (rent, subscriptions…). Label + amount,
// no category. `recurring` lines copy into the next month.
model PersonalExpense {
  id         Int      @id @default(autoincrement())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   Int
  period     PersonalPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId   Int
  category   PersonalCategory? @relation(fields: [categoryId], references: [id])
  categoryId Int?
  label      String   @default("")
  amount     Float
  note       String?
  date       DateTime @default(now())
  recurring  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Daily spends tracked in the Expenses tab — categorised, drawn against the
// remaining balance (income − fixed expenses − spends).
model PersonalSpend {
  id         Int      @id @default(autoincrement())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   Int
  period     PersonalPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId   Int
  category   PersonalCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
  amount     Float
  note       String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
}

model PersonalLoan {
  id           Int      @id @default(autoincrement())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  direction    String // lent | borrowed
  counterparty String
  amount       Float
  outstanding  Float
  note         String?
  status       String   @default("open") // open | settled
  createdAt    DateTime @default(now())
}

// A net-worth holding: a manually-valued asset or liability (stocks, MF, FD, PF, gold,
// property, land, loans…). Net worth also auto-includes credit-card outstanding
// (AccountTransaction) and open lending/borrowing (PersonalLoan) — those aren't stored here.
model NetWorthItem {
  id          Int      @id @default(autoincrement())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
  category    String   // asset | liability
  type        String   // stock | mutual_fund | fd | epf | ppf | nps | gold | cash | bank | property | land | vehicle | insurance | *_loan | other_*
  name        String
  value       Float    // current ₹ value (liabilities stored as a positive number)
  quantity    Float?   // units held (stocks / MF / gold) — optional
  institution String?  // broker / bank / fund house — optional
  notes       String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([memberId])
}

// ── Finance (Wallet) — foundation for cards, and later bank/loan/investment ──────
// A financial account the member owns. Base record; type-specific detail (e.g. credit
// limit + billing cycle) lives in a 1:1 detail table so new account types extend cleanly.
model FinanceAccount {
  id          Int      @id @default(autoincrement())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
  type        String   // credit_card | debit_card  (future: bank | loan | investment)
  name        String   // "SBI SimplyClick"
  institution String?  // bank / issuer, e.g. "SBI"
  network     String?  // visa | mastercard | rupay | amex | diners
  last4       String?
  color       String   @default("#6366f1")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  credit      CreditCardDetail?
  txns        AccountTransaction[]
  createdAt   DateTime @default(now())

  @@index([memberId])
}

// Credit-card specifics. Cycles are DERIVED from statementDay + dueOffsetDays (no
// Statement entity yet — that arrives in the statement-pipeline phase).
model CreditCardDetail {
  id            Int      @id @default(autoincrement())
  account       FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     Int      @unique
  creditLimit   Float?
  statementDay  Int?     // 1–28: day of month the statement generates
  dueOffsetDays Int?     // days after the statement date the payment is due
}

// One ledger line on an account. The dashboard computes ONLY from these confirmed rows.
// Sign convention: spend/fee/interest/charge increase owed; payment/refund/cashback
// decrease owed; reward = points only (no rupee effect); adjustment = ±.
model AccountTransaction {
  id           Int      @id @default(autoincrement())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    Int
  date         DateTime
  merchant     String
  amount       Float    // rupees, positive
  type         String   @default("spend") // spend|payment|refund|cashback|reward|fee|interest|charge|adjustment
  rewardPoints Float?   // points earned/redeemed on this line
  category     String?  // free-text category from the statement / user
  bucket       String?  // need | want | invest (optional)
  confidence   Float?   // 0–1 from extraction; low → needsReview
  needsReview  Boolean  @default(false)
  source       String   @default("manual") // manual | import
  createdAt    DateTime @default(now())

  @@index([memberId, date])
  @@index([accountId, date])
}

// A month (e.g. MAR 2026).
model Period {
  id           Int            @id @default(autoincrement())
  household    Household      @relation(fields: [householdId], references: [id])
  householdId  Int
  year         Int
  month        Int // 1-12
  label        String // "MAR 2026"
  status       String         @default("open") // open | closed
  treasurerMemberId Int? // per-month hub override; falls back to Household.treasurerMemberId
  carryForward Float          @default(0) // opening balance carried in from previous month
  movedToPiggy Float          @default(0) // amount sent to piggy at wind-down
  closedAt     DateTime?
  incomes      IncomeEntry[]
  expenses     ExpenseEntry[]
  budgets      Budget[]
  piggyEntries PiggyEntry[]
  spends       Spend[]
  settlements  SettlementRecord[]

  @@unique([householdId, year, month])
}

// Savings ledger. kind="piggy" = general Piggy (variable-category remainders);
// kind="sinking" = a sinking fund's own hold (WiFi/Mobile). categoryId gives the breakdown.
model PiggyEntry {
  id          Int       @id @default(autoincrement())
  household   Household  @relation(fields: [householdId], references: [id])
  householdId Int
  period      Period?    @relation(fields: [periodId], references: [id])
  periodId    Int?
  category    Category?  @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  kind        String     @default("piggy") // piggy | sinking
  amount      Float // positive = deposit, negative = withdrawal/payment
  note        String?
  createdAt   DateTime   @default(now())
}

// A due-month periodic bill (bill-with-a-fund) that's been paid, and how it was funded.
// One per (category, period); survives draft rebuilds so a paid bill stays paid. Scalar ids
// (no relations) keep it decoupled from the other models.
model BillPayment {
  id          Int      @id @default(autoincrement())
  householdId Int
  categoryId  Int
  periodId    Int
  memberId    Int? // the payer
  fromFund    Float    @default(0) // drawn from the bill's own ACCRUED sinking fund
  fromSetAside Float   @default(0) // covered by THIS month's own set-aside (cancels its wind-down accrual; no ledger draw)
  fromPiggy   Float    @default(0) // drawn from the general Piggy
  outOfPocket Float    @default(0) // paid out-of-pocket (also logged as a Misc Spend on the payer)
  paidAt      DateTime @default(now())

  @@unique([categoryId, periodId])
}

// Expense category (Veg, Loan, Utilities...) with a necessary/other default.
model Category {
  id          Int            @id @default(autoincrement())
  household   Household      @relation(fields: [householdId], references: [id])
  householdId Int
  name        String
  kind        String         @default("expense") // expense | income
  section     String         @default("Monthly") // Loans | Chits | Monthly | Misc
  necessary    Boolean        @default(true) // default; overridable per expense
  tracked      Boolean        @default(false) // variable category logged in the Expenses tab
  monthlyBudget Float?        // recurring default budget, used to seed new months (template)
  sinking      Boolean        @default(false) // true = accrues to its own hold until the bill is due
  cycleMonths  Int?           // payment cycle for sinking funds (WiFi=3, Mobile=12...)
  onHold       Boolean        @default(false) // paused: skipped when seeding new months & wind-down
  fixed        Boolean        @default(false) // fixed monthly bill (e.g. subscription): a recurring Sheet expense tagged to the payer, not a budget
  // "Full bill on due month" (the alternative to a sinking fund for a periodic bill):
  // the whole billAmount lands as an expense ONLY in its due month(s) — no monthly share,
  // no fund. billEveryMonths != null marks the category as this mode.
  billEveryMonths Int?        // 2 | 3 | 6 | 12 — how often the full bill recurs (null = not this mode)
  billMonth       Int?        // 1–12: the month the bill is due
  billDay         Int?        // optional day-of-month (informational)
  billAmount      Float?      // the full bill amount charged on the due month
  // "Bill with a fund" (goal-based): fundingStyle set = this category is a periodic bill
  // funded by its sinking bucket. auto = set aside (billAmount − fund) × saveEveryMonths ÷
  // months-left on each save-cadence month (self-correcting); fixed = set aside monthlyBudget;
  // none = pay it whole on the due month. The due month shows the full bill + a fund credit
  // (net = out-of-pocket). See src/lib/schedule.ts.
  fundingStyle    String?     // auto | fixed | none  (null = not a bill-with-a-fund)
  saveEveryMonths Int?        // save cadence for auto funding: 1 | 2 | 3 | 6 (null → 1/monthly). Divides billEveryMonths.
  needsReview     Boolean        @default(false) // migrated rolling sinking fund whose due month is a guess — prompt user to confirm
  responsibleMemberId Int?     // budget: over-budget excess owner; bill-with-a-fund: the SAVER who sets aside the share & holds it (bears the cost)
  payerMemberId       Int?     // bill-with-a-fund: who physically PAYS the bill on its due month (null → same as the saver). Bill + fund credit tag to them → net ~0.
  expenses     ExpenseEntry[]
  budgets      Budget[]
  spends       Spend[]
  piggyEntries PiggyEntry[]

  @@unique([householdId, name])
}

model IncomeEntry {
  id        Int      @id @default(autoincrement())
  period    Period   @relation(fields: [periodId], references: [id])
  periodId  Int
  source    String // "VL Salary", "G704 Rent"
  amount    Float
  owner     Member?  @relation(fields: [ownerId], references: [id])
  ownerId   Int?
  oneOff    Boolean  @default(false) // one-time income (e.g. a loan/piggy top-up) — NOT copied forward
  note      String?
  createdAt DateTime @default(now())
}

model ExpenseEntry {
  id         Int      @id @default(autoincrement())
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   Int
  label      String
  amount     Float
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  member     Member?  @relation(fields: [memberId], references: [id]) // attribution tag
  memberId   Int?
  necessary  Boolean  @default(true) // defaults from category, overridable
  oneOff     Boolean  @default(false) // wind-down carry (misc/over-budget) — NOT copied to future months
  note       String?
  paid       Boolean  @default(false) // a bill marked paid → drops out of "budget left in hand"
  createdAt  DateTime @default(now())
}

// Actual logged spend within a tracked category (the daily WhatsApp-group entries).
// Separate from ExpenseEntry so the Sheet (allocations) never double-counts.
model Spend {
  id         Int      @id @default(autoincrement())
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  member     Member?  @relation(fields: [memberId], references: [id])
  memberId   Int?
  label      String
  amount     Float
  subCategory String? // reporting-only tag for Personal/Misc spends (Food, Travel…); null = uncategorized
  imagePath  String? // /uploads/<file> for petrol receipts etc.
  createdAt  DateTime @default(now())
}

// A recorded settlement payment: one transfer (from → to) marked paid for a month.
// Member ids are plain scalars (names resolved from the loaded member list).
model SettlementRecord {
  id           Int       @id @default(autoincrement())
  household    Household  @relation(fields: [householdId], references: [id])
  householdId  Int
  period       Period     @relation(fields: [periodId], references: [id])
  periodId     Int
  fromMemberId Int // who pays
  toMemberId   Int // who receives (the treasurer/hub)
  amount       Float // amount recorded at settle time
  note         String?
  settledById  Int? // session member who marked it
  settledAt    DateTime   @default(now())

  @@unique([periodId, fromMemberId, toMemberId])
}

// Planned amount per category per month (planned-vs-actual).
model Budget {
  id         Int      @id @default(autoincrement())
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  planned    Float

  @@unique([periodId, categoryId])
}

// A one-off "skip this month's set-aside" for a bill-with-a-fund category. Its presence
// means: don't put this bill's monthly set-aside on that period's sheet and don't accrue
// it to the fund at wind-down. The remaining months auto-recompute higher. Source of truth
// (survives a preview rebuild). Removed = the set-aside is back to normal.
model SetAsideSkip {
  id          Int      @id @default(autoincrement())
  householdId Int
  categoryId  Int
  periodId    Int
  createdAt   DateTime @default(now())

  @@unique([categoryId, periodId])
  @@index([periodId])
}
