# Copy to .env.local and fill in. NEVER commit real secrets (.env.local is gitignored).
#
# ── Database ────────────────────────────────────────────────────────────────
# IMPORTANT: use a SEPARATE dev Supabase project for local development.
# The destructive scripts (db:seed, import:history, import:real, db:restore)
# wipe/bulk-write tables and are blocked unless ALLOW_DB_WIPE=1 — only ever set
# that flag when DATABASE_URL points at your DEV project, never production.
DATABASE_URL="postgresql://<user>:<pw>@<host>:6543/postgres?pgbouncer=true"   # pooled (app runtime)
DIRECT_URL="postgresql://<user>:<pw>@<host>:5432/postgres"                    # direct (migrations)

# ── Auth.js (Google OAuth) ──────────────────────────────────────────────────
AUTH_SECRET="<openssl rand -base64 33>"
AUTH_GOOGLE_ID="<google-oauth-client-id>"
AUTH_GOOGLE_SECRET="<google-oauth-client-secret>"
# Production only: the deployed URL (also used as the WebAuthn/biometric origin).
# AUTH_URL="https://your-app.vercel.app"
# APP_LOCK_ORIGIN="https://your-app.vercel.app"   # override if the PWA origin differs from AUTH_URL

# ── Ops ─────────────────────────────────────────────────────────────────────
CRON_SECRET="<random-string>"          # protects /api/cron/ensure-month
# ALLOW_DB_WIPE=1                       # set ONLY when running seed/import/restore against the DEV db
